# --- Database ---
DATABASE_URL=postgresql+psycopg2://marketai:marketai@localhost:5432/marketai

# --- Cache ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Data providers ---
# Leave blank to run entirely on the built-in mock provider (default, no signup needed).
# See docs/AI.md and docs/ARCHITECTURE.md for recommended real providers
# (e.g. Twelve Data / Alpha Vantage / Finnhub for market data, NewsAPI / Finnhub for news).
MARKET_DATA_PROVIDER=mock          # legacy single-provider setting; regional settings below take precedence
MARKET_DATA_API_KEY=

# --- Regional stock quotes/history ---
# Missing credentials fall back to clearly labelled mock data.
INDIA_MARKET_DATA_PROVIDER=tapetide
TAPETIDE_API_KEY=
US_MARKET_DATA_PROVIDER=alpaca
ALPACA_API_KEY=
ALPACA_API_SECRET_KEY=

NEWS_PROVIDER=mock                 # mock | newsapi | finnhub
NEWS_API_KEY=

FX_PROVIDER=mock                   # mock | exchangerate_host
FX_API_KEY=

# --- AI chatbot ---
# Leave blank to run the chatbot in rule-based/tool-routing-only mode (no external LLM calls).
LLM_PROVIDER=none                  # none | anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Paper trading defaults ---
DEFAULT_INR_DEMO_CASH=1000000
DEFAULT_USD_DEMO_CASH=100000

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
